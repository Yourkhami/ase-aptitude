# ================================================================
# ASE APTITUDE – Backend Environment Configuration
# ================================================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/ase_aptitude
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ase_aptitude?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ase_aptitude

# JWT Authentication Secret & Expiration
JWT_SECRET=ase_aptitude_super_secret_jwt_key_2026_secure_key
JWT_EXPIRES_IN=7d

# Initial Admin User Credentials (used by 'npm run seed')
ADMIN_NAME=Dir. Sajid Raja
ADMIN_EMAIL=admin@aseaptitude.com
ADMIN_PASSWORD=ase@admin2026

# Client / Frontend URL (for CORS validation)
CLIENT_URL=*
